rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funções auxiliares de autenticação e isolamento
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Perfil do usuário: Somente o próprio usuário autenticado pode ler e gravar
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Permissões e planos de acesso (Entitlements):
    // Isolamento estrito: Somente o próprio usuário autenticado pode ler ou gravar seu próprio entitlement
    // Nenhum outro usuário consegue ler ou modificar
    match /user_entitlements/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Dados do aplicativo (tarefas, rotinas, hábitos, etc.):
    // Isolamento estrito: Usuário A acessa estritamente dados de A (app_data/{userId})
    // Nenhum outro usuário consegue ler ou modificar
    match /app_data/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Códigos de acesso de compras gerados pelo webhook:
    // Permite get direto apenas com o código exato e gravação/atualização de status
    // Proíbe listagem pública (list: false) e exclusão (delete: false)
    match /access_codes/{codeId} {
      allow get: if true;
      allow create, update: if true;
      allow list, delete: if false;
    }
  }
}

